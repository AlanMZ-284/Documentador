# ============================================================================
# Documentador API — Variables de entorno (ejemplo)
# Copia este archivo como .env y ajusta los valores. NUNCA subas .env a Git.
# ============================================================================

# ── Servidor ────────────────────────────────────────────────────────────────
NODE_ENV=development
HOST=127.0.0.1
PORT=3001

# ── Base de datos (PostgreSQL en Docker, puerto 5433 en el host) ────────────
DATABASE_URL=postgresql://postgres:theluis@localhost:5433/documentador
DB_POOL_MIN=2
DB_POOL_MAX=10

# ── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=cambia_este_secreto_en_produccion_min_32_chars
JWT_EXPIRES_IN=8h

# ── SuperAdministrador inicial (usado por scripts/bootstrap-superadmin.js) ──
SUPERADMIN_EMAIL=admin@develop.mx
SUPERADMIN_PASSWORD=Admin1234!Segura
BCRYPT_COST=12

# ── Seguridad de login ──────────────────────────────────────────────────────
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_MS=60000

# ── Rate limiting global ────────────────────────────────────────────────────
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# ── CORS ────────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ── Archivos / MinIO (S3 compatible) ────────────────────────────────────────
MAX_FILE_SIZE_MB=50
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=documentador-docs

# ── IA (Fase 4 — opcionales en dev) ─────────────────────────────────────────
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# CLAUDE_MODEL=claude-sonnet-4-20250514
# CLAUDE_MAX_TOKENS=4096
# CLAUDE_TIMEOUT_MS=60000
# CLAUDE_RETRY_ATTEMPTS=2
